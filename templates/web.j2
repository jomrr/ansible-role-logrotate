{{ ansible_managed | comment(prefix_count=0, postfix_count=0) }}
# file: {{ template_destpath }}

{{ [__logrotate_web_profile.directory] | product(__logrotate_web_profile.patterns) | map('join', '/') | join(' ') }} {
{% filter indent(4, true) %}{% include '_policy.j2' %}{% endfilter +%}
    maxsize {{ logrotate_max_size_mib }}M
    missingok
    sharedscripts
{% if __logrotate_web_uses_su %}
    su nginx nginx
    create 0640 nginx nginx
{% else %}
    create 0640
{% endif %}
{% if ansible_facts.os_family == 'Debian' %}
    prerotate
        if [ -d /etc/logrotate.d/httpd-prerotate ]; then
            /usr/bin/run-parts /etc/logrotate.d/httpd-prerotate
        fi
    endscript
{% endif %}
    postrotate
        if /usr/bin/systemctl is-active --quiet {{ __logrotate_web_profile.package }}.service; then
{% if __logrotate_web == 'nginx' %}
            /usr/bin/systemctl kill --kill-whom=main --signal=USR1 nginx.service
{% else %}
            /usr/bin/systemctl reload {{ __logrotate_web_profile.package }}.service
{% endif %}
        fi
    endscript
}
